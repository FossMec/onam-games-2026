# Supabase Postgres connection string (pooled)
DATABASE_URL=

# Supabase Auth (public-safe, also exposed to the client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Auth admin (service role - server only)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Google sign-in (optional - server only).
# Set both and the consent screen shows THIS site's domain instead of the
# <project-ref>.supabase.co one. Leave them unset and sign-in falls back to
# Supabase's redirect, which is also the rollback: unset, redeploy, done.
# The client ID must also be listed under Supabase → Auth → Providers →
# Google → "Authorized Client IDs", or Supabase rejects the ID token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only needed if the public origin differs from the one the server sees
# (custom domain in front of a proxy). Must match the redirect URI registered
# in the Google console, minus /api/auth/google/callback.
AUTH_ORIGIN=

# Session / signing secrets (openssl rand -base64 32)
SESSION_SECRET=
DEVICE_PEPPER=

# Canonical site origin (Cloudflare Workers). Change this env and all og:url/canonical/sitemap switch.
# Must match AUTH_ORIGIN redirect in Google Cloud Console minus /api/auth/google/callback
VITE_SITE_URL=https://onam-games.fossmec.workers.dev
VITE_GOOGLE_SITE_VERIFICATION=
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Umami Analytics (Cloud / Self-hosted) - all configurable via env, just change and redeploy
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# Microsoft Clarity Analytics - configurable via env
VITE_CLARITY_PROJECT_ID=

# ── Open-to-all mode ─────────────────────────────────────────────────────────
# Turn the scheduled festival into a public playground.
#
#   false (default)  the original event: a game a day, closed beta, Google sign-in
#   true             every published game is live at all times, the closed-beta
#                    door is lifted, and sign-up is just a name (no Google)
#
# Only name-only players appear on the leaderboards in this mode, so a database
# carried over from the closed event does not show last year's finishers.
# Server-side only on purpose - the client learns the mode from the server so a
# stale build can never disagree with the code that enforces it.
OPEN_TO_ALL=false
